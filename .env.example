# 서버 환경변수 예시. 실제 값은 이 파일이 아니라 서버 환경변수(또는 저장소의 .env, 커밋 금지)에만 둔다.
PROVIDER=kis                 # kis | mock (키움은 어댑터 자리만 있다)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_WS_MAX_SUBS=40           # WebSocket 동시 구독 상한 — 장중에 실제 한도를 확인해 맞춘다
POLL_INTERVAL_SEC=40         # 전 종목 REST 폴링 주기
LIVE_AUTH_TOKEN=             # 화면·API 접근 토큰(필수). 길고 무작위인 값
W52_DB_PATH=cache/w52/w52.db
# 배치에서만 쓰는 키(기존): KRX_API_KEY, DART_API_KEY
